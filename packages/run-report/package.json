{
  "name": "@linelab/run-report",
  "version": "0.0.0",
  "private": true,
  "description": "Run report: failure events (with source lines), static analysis and metrics for one simulated run.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@linelab/firmware-lint": "workspace:*",
    "@linelab/firmware-runtime": "workspace:*",
    "@linelab/schema": "workspace:*",
    "@linelab/sim-core": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@linelab/component-db": "workspace:*",
    "@linelab/design-core": "workspace:*"
  }
}
