{
  "name": "@linelab/component-db",
  "version": "0.0.0",
  "private": true,
  "description": "Open component and chassis database (JSON, CC-BY-SA-4.0) plus its validator.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "default": "./dist/validate/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "catalog:generate": "tsx scripts/build-catalog.ts",
    "build": "pnpm catalog:generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm catalog:generate && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm catalog:generate && vitest run",
    "db:validate": "tsx scripts/validate.ts"
  },
  "dependencies": {
    "@linelab/schema": "workspace:*",
    "@linelab/sim-core": "workspace:*",
    "@linelab/three-models": "workspace:*",
    "fuse.js": "7.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "three": "0.187.0",
    "@types/three": "0.187.0"
  }
}
