{
  "name": "@linelab/agent",
  "version": "0.0.0",
  "private": true,
  "description": "AI debug agent: prompts, tools and the patch verification gate.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "inject-bugs": "tsx scripts/inject-bugs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@linelab/component-db": "workspace:*",
    "@linelab/design-core": "workspace:*",
    "@linelab/firmware-lint": "workspace:*",
    "@linelab/firmware-runtime": "workspace:*",
    "@linelab/run-report": "workspace:*",
    "@linelab/schema": "workspace:*",
    "@linelab/sim-core": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@linelab/compiler": "workspace:*",
    "fast-check": "4.11.0",
    "tsx": "4.23.15"
  }
}
