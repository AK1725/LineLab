{
  "name": "@linelab/firmware-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "avr8js / rp2040js adapters and HAL-shim bindings that connect firmware to sim-core.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --testTimeout 60000 --hookTimeout 120000"
  },
  "dependencies": {
    "@linelab/design-core": "workspace:*",
    "@linelab/schema": "workspace:*",
    "@linelab/sim-core": "workspace:*",
    "avr8js": "0.21.1"
  },
  "devDependencies": {
    "@linelab/component-db": "workspace:*"
  }
}
