{
  "name": "@linelab/firmware-lint",
  "version": "0.0.0",
  "private": true,
  "description": "Line-follower lint rules for Arduino sketches (delay in the loop, integer PID maths, unclamped integrals, pin mismatches, ...).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --testTimeout 60000 --hookTimeout 120000"
  },
  "dependencies": {
    "@linelab/schema": "workspace:*"
  }
}
