{
  "name": "@linelab/three-models",
  "version": "0.0.0",
  "private": true,
  "description": "Procedural three.js models for every component, built from its real dimensions (Z up, mm).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --testTimeout 60000 --hookTimeout 120000"
  },
  "dependencies": {
    "three": "0.187.0",
    "zod": "4.6.7",
    "@linelab/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/three": "0.187.0"
  }
}
