{
  "name": "@linelab/sim-core",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic 1 kHz physics, sensor and track model, metrics and failure detectors. No DOM.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "tracks:generate": "tsx scripts/build-tracks.ts",
    "db:validate": "tsx scripts/validate-tracks.ts",
    "sim": "tsx scripts/sim.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@linelab/schema": "workspace:*",
    "@linelab/design-core": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.11.0",
    "@linelab/component-db": "workspace:*"
  }
}
