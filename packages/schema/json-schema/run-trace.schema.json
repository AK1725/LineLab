{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "designHash": {
      "type": "string",
      "minLength": 1
    },
    "firmwareHash": {
      "type": "string",
      "minLength": 1
    },
    "trackId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9_-]*)+$"
    },
    "dtMs": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tMs": {
            "type": "number",
            "minimum": 0
          },
          "pose": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "headingRad": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "headingRad"
            ],
            "additionalProperties": false
          },
          "velocity": {
            "type": "object",
            "properties": {
              "v": {
                "type": "number"
              },
              "omega": {
                "type": "number"
              }
            },
            "required": [
              "v",
              "omega"
            ],
            "additionalProperties": false
          },
          "sensors": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "pwm": {
            "type": "object",
            "properties": {
              "left": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "right": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "required": [
              "left",
              "right"
            ],
            "additionalProperties": false
          },
          "batteryV": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "tMs",
          "pose",
          "velocity",
          "sensors",
          "pwm",
          "batteryV"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tMs": {
            "type": "number",
            "minimum": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "line_lost",
              "line_reacquired",
              "off_track",
              "oscillation",
              "stuck",
              "infinite_loop",
              "missed_turn",
              "pwm_saturation",
              "integrator_windup",
              "brownout",
              "wdt_reset",
              "blocking_delay",
              "control_loop_jitter",
              "checkpoint",
              "lap_complete"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "sourceLoc": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "fn": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "line"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "tMs",
          "type",
          "severity",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "completionPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "lapTimeMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "meanLateralErrorMm": {
          "type": "number",
          "minimum": 0
        },
        "maxLateralErrorMm": {
          "type": "number",
          "minimum": 0
        },
        "loopFrequencyHz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "energyJ": {
          "type": "number",
          "minimum": 0
        },
        "oscillationIndex": {
          "type": "number",
          "minimum": 0
        },
        "robustness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "completionPct",
        "meanLateralErrorMm",
        "maxLateralErrorMm"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "runId",
    "seed",
    "designHash",
    "trackId",
    "dtMs",
    "frames",
    "events",
    "metrics"
  ],
  "additionalProperties": false,
  "$id": "https://linelab.dev/schema/run-trace.schema.json",
  "title": "LineLab run-trace"
}
