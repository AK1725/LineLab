{
  "name": "@linelab/api",
  "version": "0.0.0",
  "private": true,
  "description": "LineLab HTTP API: projects, designs, runs, feedback and AI-agent orchestration.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --testTimeout 60000 --hookTimeout 120000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@linelab/agent": "workspace:*",
    "@linelab/component-db": "workspace:*",
    "@linelab/design-core": "workspace:*",
    "@linelab/photo-design": "workspace:*",
    "@linelab/schema": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "nodemailer": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}
