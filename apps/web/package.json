{
  "name": "@linelab/web",
  "version": "0.0.0",
  "private": true,
  "description": "LineLab web studio (Next.js).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-examples.mjs && next dev --port 3000",
    "build": "node scripts/gen-examples.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "node scripts/gen-examples.mjs && tsc --noEmit",
    "lint": "node scripts/gen-examples.mjs && eslint . --max-warnings 0",
    "test": "vitest run --testTimeout 60000 --hookTimeout 120000 --passWithNoTests"
  },
  "dependencies": {
    "@linelab/agent": "workspace:*",
    "@linelab/calibrate": "workspace:*",
    "@linelab/component-db": "workspace:*",
    "@linelab/design-core": "workspace:*",
    "@linelab/firmware-lint": "workspace:*",
    "@linelab/firmware-runtime": "workspace:*",
    "@linelab/photo-design": "workspace:*",
    "@linelab/rules-engine": "workspace:*",
    "@linelab/run-report": "workspace:*",
    "@linelab/schema": "workspace:*",
    "@linelab/sim-core": "workspace:*",
    "@linelab/telemetry-lib": "workspace:*",
    "@linelab/three-models": "workspace:*",
    "@monaco-editor/react": "4.7.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "idb-keyval": "6.3.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5"
  }
}
