# Copy to the repo root as .env for a public demo (deploy/compose.demo.yml). Never commit .env.
DEMO_DOMAIN=linelab.example.org
# openssl rand -hex 32
AUTH_SECRET=
POSTGRES_PASSWORD=
# Optional: AI debugger and photo import (server key). Users can also bring their own key.
ANTHROPIC_API_KEY=
# Email sign-in links (any SMTP provider). Without it, links only appear in the API log.
SMTP_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM=LineLab <no-reply@linelab.example.org>
# Optional: "Continue with GitHub" (OAuth app callback: https://<domain>/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
