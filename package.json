{
  "name": "linelab",
  "private": true,
  "description": "Open-source studio to design, wire, simulate and debug line-following robots.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:validate": "turbo run db:validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:validate && pnpm build",
    "test:e2e": "pnpm --filter @linelab/e2e test:e2e",
    "sim": "pnpm --filter @linelab/sim-core sim",
    "bench:sim": "turbo run build --filter=@linelab/sim-core... --output-logs=errors-only && pnpm --filter @linelab/sim-core bench"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
