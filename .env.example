# Copy to .env and fill in. Never commit .env.

# --- Infrastructure (matches docker-compose.yml defaults) ---
DATABASE_URL=postgres://linelab:linelab@localhost:5432/linelab
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=linelab
S3_SECRET_KEY=linelab-dev-secret
S3_BUCKET=linelab

# --- Services ---
API_PORT=4000
VISION_URL=http://localhost:8000

# --- AI debug agent (Phase 8). Server-side only; never exposed to the browser. ---
ANTHROPIC_API_KEY=
LINELAB_AGENT_MODEL=claude-opus-5-5
